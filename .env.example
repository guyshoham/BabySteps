# Firebase Admin (Service account → Project settings → Service accounts → Generate key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 (R2 → Manage API tokens → S3-compatible credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=babysteps-videos

# Shared secret Make must send in the x-enroll-secret header
ENROLL_SECRET=

# JSON map of PayPal product/button id -> Firestore courseId
COURSE_MAP={"ROLLING-2024":"rolling","TUMMY-2024":"tummy-time"}

# Tester account (scripts/create-tester.js). Leave the password empty to generate one.
TESTER_EMAIL=tester@babysteps.test
TESTER_PASSWORD=

# Make webhook that receives PayPal IPNs (scripts/fake-payment.sh). Keep it private:
# Make does not verify IPNs, so anyone with this URL can fake a payment.
MAKE_HOOK_URL=
